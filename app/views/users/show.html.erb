<section class="user">
  <h1><%= @user.name %></h1>
  <h2><%= @user.username %></h2>
  <h2><%= mail_to(@user.email) %></h2>

  <div class="actions">
    <% if current_user?(@user)%>
      <%= link_to "Edit", edit_user_path(@user), class: "button edit" %>
      <%= link_to "Delete", user_path(@user), class: "button delete",
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
</section>
   